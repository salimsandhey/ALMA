generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum GameType {
  FLASHCARD
  WORD_MATCH
  FILL_BLANK
  TRUE_FALSE
  DIALOGUE
  IMAGE_SPEAK
}

enum EntertainmentType {
  VIDEO
  ARTICLE
}

enum ContentCategory {
  PHRASE_OF_THE_DAY
  GRAMMAR_TIP
  CULTURE_NOTE
  HOSPITALITY_FACT
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String?
  role                 Role      @default(STUDENT)
  displayName          String
  avatarUrl            String?
  age                  Int?
  gender               Gender?
  nativeLanguage       String?
  country              String?
  isEmailVerified      Boolean   @default(false)
  isOnboardingComplete Boolean   @default(false)
  isActive             Boolean   @default(true)
  googleId             String?   @unique
  appleId              String?   @unique
  xpTotal              Int       @default(0)
  streakCount          Int       @default(0)
  lastActiveDate       DateTime?
  lastGreetingDate     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  otpCodes                OTPCode[]
  lessonProgress          LessonProgress[]
  moduleProgress          ModuleProgress[]
  userBadges              UserBadge[]
  feedbacks               Feedback[]
  aiUsageLogs             AIUsageLog[]
  dailyChallengeAttempts  DailyChallengeAttempt[]
  entertainmentAttempts   EntertainmentAttempt[]

  @@index([email])
  @@index([role])
  @@index([xpTotal])
}

// ─────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────

model OTPCode {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OTPPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([code])
}

// ─────────────────────────────────────────────
// MODULE
// ─────────────────────────────────────────────

model Module {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  orderIndex  Int      @unique
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons        Lesson[]
  moduleProgress ModuleProgress[]

  @@index([orderIndex])
  @@index([isPublished])
}

// ─────────────────────────────────────────────
// LESSON
// ─────────────────────────────────────────────

model Lesson {
  id         String   @id @default(cuid())
  moduleId   String
  title      String
  orderIndex Int
  gameType   GameType
  xpReward   Int      @default(20)
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([moduleId, orderIndex])
  @@index([moduleId])
}

// ─────────────────────────────────────────────
// PROGRESS
// ─────────────────────────────────────────────

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  isCompleted  Boolean   @default(false)
  xpEarned     Int       @default(0)
  attemptCount Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model ModuleProgress {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// BADGE
// ─────────────────────────────────────────────

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  iconUrl     String?
  condition   String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// EXPLORE CONTENT
// ─────────────────────────────────────────────

model ExploreContent {
  id        String          @id @default(cuid())
  title     String
  body      String
  category  ContentCategory
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([category])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// FEEDBACK
// ─────────────────────────────────────────────

model Feedback {
  id             String    @id @default(cuid())
  userId         String
  rating         Int
  topic          String?
  comment        String?
  adminReply     String?
  adminRepliedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// SONG
// ─────────────────────────────────────────────

model Song {
  id          String   @id @default(cuid())
  title       String
  artist      String
  genre       String
  emoji       String
  youtubeUrl  String
  bgMusicUrl  String?
  lyrics      String[]
  isPublished Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([orderIndex])
}

// ─────────────────────────────────────────────
// DAILY CHALLENGE
// ─────────────────────────────────────────────

model DailyChallenge {
  id          String   @id @default(cuid())
  question    String
  sampleAnswer String
  keywords    String[]
  xpReward    Int      @default(10)
  isActive    Boolean  @default(true)
  orderIndex  Int      @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts DailyChallengeAttempt[]

  @@index([isActive])
  @@index([orderIndex])
}

model DailyChallengeAttempt {
  id            String   @id @default(cuid())
  userId        String
  challengeId   String
  challengeDate String
  correct       Boolean
  spokenText    String
  xpEarned      Int      @default(0)
  createdAt     DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeDate])
  @@index([userId])
  @@index([challengeDate])
}

// ─────────────────────────────────────────────
// ENTERTAINMENT
// ─────────────────────────────────────────────

model EntertainmentContent {
  id          String            @id @default(cuid())
  type        EntertainmentType
  title       String
  description String
  url         String
  duration    String?
  xpReward    Int               @default(30)
  orderIndex  Int
  isPublished Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  questions EntertainmentQuestion[]
  attempts  EntertainmentAttempt[]

  @@index([type])
  @@index([isPublished])
  @@index([orderIndex])
}

model EntertainmentQuestion {
  id             String               @id @default(cuid())
  contentId      String
  question       String
  expectedAnswer String
  keywords       String[]
  orderIndex     Int
  createdAt      DateTime             @default(now())

  content EntertainmentContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model EntertainmentAttempt {
  id        String               @id @default(cuid())
  userId    String
  contentId String
  score     Int
  xpEarned  Int                  @default(0)
  answers   Json
  createdAt DateTime             @default(now())

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  content EntertainmentContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ─────────────────────────────────────────────
// REFERENCE DATA
// ─────────────────────────────────────────────

model Country {
  id   String @id @default(cuid())
  name String
  code String @unique

  @@index([name])
}

model Language {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  flag        String
  isSuggested Boolean @default(false)
  orderIndex  Int     @default(999)

  @@index([orderIndex])
}

// ─────────────────────────────────────────────
// LEGAL CONTENT
// ─────────────────────────────────────────────

model LegalContent {
  id        String   @id @default(cuid())
  type      String   @unique
  sections  Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─────────────────────────────────────────────
// APP SETTINGS
// ─────────────────────────────────────────────

model AppSettings {
  id                      String   @id @default("singleton")
  coachDailyLimit         Int      @default(30)
  greetingDailyLimit      Int      @default(20)
  grammarDailyLimit       Int      @default(30)
  warmupDailyLimit        Int      @default(3)
  pronunciationDailyLimit Int      @default(50)
  hintDailyLimit          Int      @default(5)
  iosAppUrl               String?
  androidAppUrl           String?
  defaultBgMusicUrl       String?
  updatedAt               DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AI USAGE LOG
// ─────────────────────────────────────────────

model AIUsageLog {
  id           String   @id @default(cuid())
  userId       String
  feature      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  aiModel      String   @default("gemini-2.5-flash")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// TTS AUDIO CACHE
// ─────────────────────────────────────────────

model TtsAudioCache {
  id             String   @id @default(cuid())
  textHash       String   @unique
  text           String
  audioUrlMale   String
  audioUrlFemale String
  createdAt      DateTime @default(now())

  @@index([textHash])
}
