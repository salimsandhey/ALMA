{
  "expo": {
    "name": "ALMA",
    "slug": "alma-app",
    "scheme": "alma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-speech-recognition",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ALMA to access your photos for profile picture."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "./plugins/withGradleProperties"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.almalearn.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F4B"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F4B"
      },
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B1F4B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.alma.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6864962-35c9-46a6-a087-93c0b4da353a"
      }
    }
  }
}
